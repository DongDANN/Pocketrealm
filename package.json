{
  "name": "pocketrealm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An offline-first, gamified budgeting PWA with a deterministic pixel dungeon.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src scripts tests e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sim:delve": "tsx scripts/sim-delve.ts",
    "sim:golden": "tsx scripts/golden-hashes.ts",
    "art:sheets": "tsx scripts/render-art-sheets.ts && tsx scripts/gen-ui-assets.ts",
    "art:validate": "tsx scripts/validate-art.ts",
    "icons": "tsx scripts/gen-icons.ts",
    "ui:assets": "tsx scripts/gen-ui-assets.ts",
    "lighthouse": "lhci autorun",
    "art:shots": "tsx scripts/shoot-app.ts"
  },
  "dependencies": {
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "fake-indexeddb": "6.2.6",
    "gifenc": "^1.0.3",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  }
}
